{
  "name": "tessera-backend",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/worker.js",
    "test": "vitest run",
    "migrate": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "bcryptjs": "3.0.3",
    "bullmq": "6.3.2",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "express-rate-limit": "^7.5.1",
    "fast-xml-parser": "4.5.7",
    "fflate": "0.8.3",
    "ioredis": "5.9.0",
    "jsonwebtoken": "9.0.3",
    "linkedom": "0.18.11",
    "multer": "2.2.0",
    "pg": "8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^4.3.1",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.31",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
