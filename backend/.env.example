PORT=4000
DATABASE_URL=postgres://tessera:tessera@localhost:5433/tessera
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-to-a-long-random-string
UPLOADS_DIR=./uploads

# --- Embeddings (ADR-0017/0025) --------------------------------------------
# gemini | openai | mock. Unset infers from the configured key; no key uses Mock.
EMBEDDING_PROVIDER=

# Google AI Studio. The model is configuration, never a code fallback.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# OpenAI-compatible alternative. When selected, all three values are required.
# EMBEDDING_API_KEY=nvapi-...
# EMBEDDING_API_BASE=https://integrate.api.nvidia.com/v1
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# EMBEDDING_INPUT_STYLE=input_type

# `prefix` adds "query: "/"passage: " locally; `input_type` lets the endpoint
# mark retrieval inputs. Do not use both.
# EMBEDDING_INPUT_STYLE=prefix

# --- Synthesis / LLM (ADR-0003) ---------------------------------------------
# Evidence text may only go to the paid, contractually no-training provider.
# Configure its OpenAI-compatible endpoint and repeat its HTTPS origin in
# SYNTHESIS_ALLOWED_ORIGIN; the backend refuses any mismatched destination.
# Also used to name new Stories (#51) — headlines only, never article text. With
# no key set, the deterministic Mock names them and says so in the title.
SYNTHESIS_PROVIDER=
SYNTHESIS_API_KEY=
SYNTHESIS_API_BASE=
SYNTHESIS_ALLOWED_ORIGIN=
SYNTHESIS_MODEL=

# --- Clustering (ADR-0026, #49) ---------------------------------------------
# Cosine threshold for automatic assignment. Default: 0.85.
# CLUSTERING_SIMILARITY_THRESHOLD=0.85

# Story recency hard gate in hours. Default: 72.
# CLUSTERING_RECENCY_WINDOW_HOURS=72

# Texts per embedding request. The run drains the full eligible backlog in
# batches; this only bounds each provider request. Default: 32.
# CLUSTERING_EMBED_BATCH_SIZE=32

# --- Graph resolution (ADR-0019, ADR-0028, #66, #67, #68, #69) ---------------
# Distinct Articles a surface name must appear in to become an Entity. This is
# what keeps the node count bounded by the data rather than by a cleanup job —
# one measured GKG window yields ~2,000 distinct person names but 195 nodes at
# 5. Lowering it grows the graph fast. Default: 5.
# GRAPH_ENTITY_PROMOTION_FLOOR=5

# Edges kept per Entity, strongest co-occurrence first and applied from both
# ends of a pair. Bounds how much of the picture a node can carry, not how many
# nodes there are. Default: 25.
# GRAPH_EDGES_PER_ENTITY=25

# Trigram similarity (0–1) at which the pass folds two names itself, and the
# floor of the band beneath it where a pair waits for an Admin instead. v3 §18.5:
# a wrong merge is more harmful than an unresolved duplicate, so the automatic
# bar sits above every wrong merge measured on real GKG names — `john kennedy`
# /`john f kennedy` scores 0.867, `united states`/`united states steel` 0.778 —
# and the doubt goes in the band. The floor is the shortest right merge still
# reachable (`james comey`/`james coney`, 0.600); below it nothing is proposed,
# so `joe biden`/`joseph biden` (0.533) needs a hand-written alias row instead.
# The review floor must stay below the automatic bar — an empty band would merge
# every candidate unseen, which is the one misconfiguration that fails silently
# in the harmful direction, so it is refused at load. Defaults: 0.9 and 0.6.
# GRAPH_ENTITY_MERGE_AUTO_SIMILARITY=0.9
# GRAPH_ENTITY_MERGE_REVIEW_SIMILARITY=0.6

# What one screen of the graph holds (#68), which is a smaller number than what is
# worth storing: the pass keeps 195 nodes at 25 neighbours each, and all of them at
# once is a hairball to pan rather than a picture to read. `GET /api/v1/graph` names
# neither of these, so a caller cannot widen them; the page states how much of the
# working set it drew instead. Per-Entity edges are applied from both ends, as the
# pass's bound is, and the pass's bound is the real ceiling above this one — past
# GRAPH_EDGES_PER_ENTITY there is nothing stored to return. Defaults: 60 and 6.
# GRAPH_VIEW_NODES=60
# GRAPH_VIEW_EDGES_PER_ENTITY=6

# What one Entity's neighbourhood holds on top of those two (#69), both about a
# list a person reads rather than about what the graph stores. Themes are the
# facet a crowded name is narrowed by (ADR-0028 — never a node): the vocabulary
# is 2,072 values at ~48 per Article, so a well-reported name carries hundreds
# and only the head of that distribution is a filter you can take in at a
# glance. Citations are the reporting under one opened link, newest first, with
# the link's whole weight stated above them — a heavy pair runs to hundreds of
# Articles, and what a reader opens a line for is enough to check the two names
# really were reported together. Defaults: 12 and 20.
# GRAPH_VIEW_THEME_FACETS=12
# GRAPH_VIEW_EDGE_CITATIONS=20

# --- Market data (Phase 3.6, ADR-0030) --------------------------------------
# Finnhub: 60 calls/min on the free tier, real-time US quotes. With no key set
# the deterministic Mock provider runs, so the demo works offline on the same
# code path (the pattern EMBEDDING_* and SYNTHESIS_* already follow).
# vitest.config.ts must pin these empty like the others, or a test run could
# reach a live provider by accident.
MARKET_PROVIDER=
MARKET_API_KEY=
MARKET_API_BASE=https://finnhub.io/api/v1

# --- Publisher bias ratings (Phase 3.6) -------------------------------------
# AllSides Media Bias Ratings, CC BY-NC 4.0 — free for non-commercial use with
# attribution, which the UI displays wherever a rating is shown. The ratings
# ship as a checked-in data file rather than a live fetch; this only points at
# where that file lives so a re-import can find it again.
# BIAS_RATINGS_FILE=src/seedData/allsides-ratings.json
