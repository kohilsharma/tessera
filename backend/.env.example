PORT=4000
DATABASE_URL=postgres://tessera:tessera@localhost:5433/tessera
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-to-a-long-random-string
UPLOADS_DIR=./uploads

# --- Embeddings (ADR-0017/0023) --------------------------------------------
# Which hosted provider to embed with: gemini | openai | mock.
# Leave unset to infer from whichever key is present below; with no key at all
# everything falls back to the deterministic Mock (what all tests use, ADR-0003).
# Switching providers means re-embedding from scratch — see SETUP.md.
EMBEDDING_PROVIDER=

# Option A — Google AI Studio (ADR-0023's default). Free key:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001

# Option B — NVIDIA's own API (free key, no card: https://build.nvidia.com).
# nemotron-3-embed-1b is #1 on RTEB and is what the third-party gateway below
# was silently serving anyway — this is the same model from the vendor.
# EMBEDDING_API_KEY=nvapi-...
# EMBEDDING_API_BASE=https://integrate.api.nvidia.com/v1
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# EMBEDDING_INPUT_STYLE=input_type

# Option C — any other OpenAI-compatible /v1/embeddings gateway.
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_API_BASE=https://api.hcnsec.cn/v1
# EMBEDDING_MODEL=Qwen3-Embedding-8B

# How a text is marked as a query rather than a document, for the asymmetric
# retrieval models both options serve. `prefix` (the default) glues
# "query: "/"passage: " onto the text — what a plain gateway needs. `input_type`
# sends it as a body field and lets the server prefix — what NVIDIA NIM expects;
# doing both would double the prefix.
# EMBEDDING_INPUT_STYLE=prefix

# EMBEDDING_MODEL / EMBEDDING_API_BASE override the model id and endpoint for
# whichever provider is active (ADR-0003: no hardcoded model ids or hosts).

# --- Synthesis / LLM (ADR-0003) ---------------------------------------------
# Which provider generates cited synthesis: openai | mock.
# "openai" means the *protocol*, not the vendor — NVIDIA, Gemini, DeepSeek and
# any OpenAI-compatible gateway all speak /chat/completions, so switching is
# these three vars and no new code. Unset infers from the key; with no key the
# deterministic Mock runs (what the whole test suite uses).
SYNTHESIS_PROVIDER=
SYNTHESIS_API_KEY=
SYNTHESIS_API_BASE=
SYNTHESIS_MODEL=

# Verified working options (measured 2026-08-31):
#   NVIDIA  base https://integrate.api.nvidia.com/v1
#           model openai/gpt-oss-20b        (3/3 valid, ~17s median, 40 RPM)
#           model poolside/laguna-xs-2.1    (3/3 valid, ~1.1s median)
#           model minimaxai/minimax-m3      (3/3 valid, ~23s median)
#   Gemini  base https://generativelanguage.googleapis.com/v1beta/openai
#           model gemini-3.5-flash-lite     (15 RPM / 500 RPD free)
#   DeepSeek base https://api.deepseek.com  (paid, ~$0.14/$0.28 per 1M)


# --- Clustering (ADR-0026, #49) ---------------------------------------------
# Two tunables and two bounds, all optional — the defaults below are what the
# code uses when these are unset, and an unparseable value fails at startup
# rather than silently running at a threshold nobody chose.
#
# Cosine similarity an Article must reach against a Story's centroid to join it.
# Calibrate it against whichever embedding model is serving: there is no eval
# harness until Phase 5, and a false merge corrupts every claim later synthesised
# from that Story, so err tight.
# CLUSTERING_SIMILARITY_THRESHOLD=0.85
#
# How long a Story stays a candidate after it was last seen. A hard gate, not a
# weighted term: outside it, no similarity is enough.
# CLUSTERING_RECENCY_WINDOW_HOURS=72
#
# The ceiling on one hourly run: Articles embedded, and Articles considered for
# assignment. A backlog drains over runs rather than in one.
# CLUSTERING_MAX_ARTICLES_PER_RUN=200
#
# Texts per embedding request (hosted limits count requests, not tokens).
# CLUSTERING_EMBED_BATCH_SIZE=32
