PORT=4000
DATABASE_URL=postgres://tessera:tessera@localhost:5433/tessera
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-to-a-long-random-string
UPLOADS_DIR=./uploads

# ADR-0023: optional. Unset (the default) uses the deterministic Mock
# EmbeddingProvider everywhere — seed, search, and all tests. Set this to a
# Google AI Studio API key to embed with the hosted gemini-embedding-001
# instead; EMBEDDING_MODEL overrides the model id and EMBEDDING_API_BASE the
# endpoint (no hardcoded IDs or hosts, ADR-0003). Leave the base unset for
# Google AI Studio; set it to point at an OpenAI-compatible gateway instead.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_BASE=
