PORT=4000
DATABASE_URL=postgres://tessera:tessera@localhost:5433/tessera
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-to-a-long-random-string
UPLOADS_DIR=./uploads

# --- Embeddings (ADR-0017/0025) --------------------------------------------
# gemini | openai | mock. Unset infers from the configured key; no key uses Mock.
EMBEDDING_PROVIDER=

# Google AI Studio. The model is configuration, never a code fallback.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# OpenAI-compatible alternative. When selected, all three values are required.
# EMBEDDING_API_KEY=nvapi-...
# EMBEDDING_API_BASE=https://integrate.api.nvidia.com/v1
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# EMBEDDING_INPUT_STYLE=input_type

# `prefix` adds "query: "/"passage: " locally; `input_type` lets the endpoint
# mark retrieval inputs. Do not use both.
# EMBEDDING_INPUT_STYLE=prefix

# --- Synthesis / LLM (ADR-0003) ---------------------------------------------
# Evidence text may only go to the paid, contractually no-training provider.
# Configure its OpenAI-compatible endpoint and repeat its HTTPS origin in
# SYNTHESIS_ALLOWED_ORIGIN; the backend refuses any mismatched destination.
# Also used to name new Stories (#51) — headlines only, never article text. With
# no key set, the deterministic Mock names them and says so in the title.
SYNTHESIS_PROVIDER=
SYNTHESIS_API_KEY=
SYNTHESIS_API_BASE=
SYNTHESIS_ALLOWED_ORIGIN=
SYNTHESIS_MODEL=

# --- Clustering (ADR-0026, #49) ---------------------------------------------
# Cosine threshold for automatic assignment. Default: 0.85.
# CLUSTERING_SIMILARITY_THRESHOLD=0.85

# Story recency hard gate in hours. Default: 72.
# CLUSTERING_RECENCY_WINDOW_HOURS=72

# Texts per embedding request. The run drains the full eligible backlog in
# batches; this only bounds each provider request. Default: 32.
# CLUSTERING_EMBED_BATCH_SIZE=32

# --- Graph resolution (ADR-0019, ADR-0028, #66) ------------------------------
# Distinct Articles a surface name must appear in to become an Entity. This is
# what keeps the node count bounded by the data rather than by a cleanup job —
# one measured GKG window yields ~2,000 distinct person names but 195 nodes at
# 5. Lowering it grows the graph fast. Default: 5.
# GRAPH_ENTITY_PROMOTION_FLOOR=5

# Edges kept per Entity, strongest co-occurrence first and applied from both
# ends of a pair. Bounds how much of the picture a node can carry, not how many
# nodes there are. Default: 25.
# GRAPH_EDGES_PER_ENTITY=25
